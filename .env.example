# 「点时成金」环境变量示例
# 用法：cp .env.example .env  然后按需修改
#
# 键集合已与 app/config.py 的 Settings 字段完整对齐（19 项），
# 并合并了 news_scraper_llm 独立使用的 4 个 LLM 键。
# 未在此列出的字段将使用 app/config.py 中的默认值（Settings 配置了 extra="ignore"）。

# ===== 数据库 =====
# 默认 SQLite 文件型，开箱即用；切 PostgreSQL 只需改这一行
DATABASE_URL=sqlite:///./data/gold_predictor.db
# DATABASE_URL=postgresql://gold:gold@localhost:5432/gold_predictor
#
# 下方连接池参数仅 PostgreSQL 生效，SQLite 下被忽略
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_ECHO=false                 # 设为 true 打印所有 SQL（调试用）

# ===== 运行模式 =====
# DEMO_MODE=true  ：仪表盘读 demo_data；后端调度器【不启动】
# DEMO_MODE=false ：启用 APScheduler 实时采集与信号生成
DEMO_MODE=true
DEBUG=true
APP_ENV=development
LOG_LEVEL=INFO

# ===== FastAPI =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== 调度间隔（秒，仅 DEMO_MODE=false 时生效）=====
COLLECT_INTERVAL_SECONDS=60     # 因子采集
SIGNAL_INTERVAL_SECONDS=300     # 信号生成

# ===== LLM（app/config.py 读取）=====
OPENAI_API_KEY=
OPENAI_MODEL=qwen-turbo
LLM_DAILY_BUDGET_USD=5

# ===== LLM 扩展（news_scraper_llm 独立读取，不在 Settings 中）=====
OPENAI_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=30
LLM_MAX_CONCURRENCY=3

# ===== 新闻 API（NewsAPI 备用源；主源为 news_scraper_llm 自建爬虫）=====
NEWSAPI_KEY=
NEWSAPI_DAILY_LIMIT=100
