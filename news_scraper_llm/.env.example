# 必填：阿里云百炼 / OpenAI 兼容 API Key（qwen-turbo 免费模型使用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认已指向阿里云百炼 OpenAI 兼容端点（调用免费模型 qwen-turbo）
# 如需切回官方 OpenAI，取消注释并改为：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1
OPENAI_MODEL=qwen-turbo

OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=30

# 并发控制（避免触发限流；免费模型并发更低，建议 2~3）
LLM_MAX_CONCURRENCY=3

# 情感分析模式：general = 通用新闻正/负/中；gold = 针对黄金价格利多/利空
SENTIMENT_MODE=general

# 抓取行为
HEADLESS=true
BROWSER=chromium
MAX_ITEMS_PER_SITE=10
POLITE_DELAY_MS=1000

# 是否进入详情页抓取正文摘要（会增加请求量，默认关闭）
FETCH_ARTICLE_SUMMARIES=false

# 输出目录
OUTPUT_DIR=./data/news_scraper_output
